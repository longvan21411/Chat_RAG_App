@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Security.Claims

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🤖 Chat RAG</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="chat">
                <span class="bi bi-chat-dots-fill-nav-menu" aria-hidden="true"></span> Chat
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="chat-history">
                <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Chat History
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="images">
                <span class="bi bi-images-nav-menu" aria-hidden="true"></span> Images
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard">
                <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
    </nav>

    <AuthorizeView>
        <Authorized Context="authState">
            <div class="user-panel">
                <a class="user-card" href="/account/profile">
                    <div class="user-avatar">@GetInitials(authState.User)</div>
                    <div class="user-meta">
                        <div class="user-name">@GetDisplayName(authState.User)</div>
                        <div class="user-subtitle">@GetSubtitle(authState.User)</div>
                    </div>
                </a>

                <button type="button" class="theme-toggle" @onclick="OnToggleTheme">
                    <span class="theme-toggle-label">Dark/Light</span>
                    <span class="theme-toggle-value">@(IsDarkMode ? "Dark" : "Light")</span>
                </button>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public bool IsDarkMode { get; set; }

    [Parameter] public EventCallback OnToggleTheme { get; set; }

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        var displayName = user.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        var userName = user.FindFirst("preferred_username")?.Value;
        if (!string.IsNullOrWhiteSpace(userName))
        {
            return userName;
        }

        return "User";
    }

    private static string GetSubtitle(ClaimsPrincipal user)
    {
        var email = user.FindFirst(ClaimTypes.Email)?.Value;
        if (!string.IsNullOrWhiteSpace(email))
        {
            return email;
        }

        var provider = user.FindFirst("provider")?.Value;
        return string.IsNullOrWhiteSpace(provider) ? "Profile" : provider;
    }

    private static string GetInitials(ClaimsPrincipal user)
    {
        var source = GetDisplayName(user)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0]));

        var initials = new string(source.ToArray());
        return string.IsNullOrWhiteSpace(initials) ? "U" : initials;
    }
}

