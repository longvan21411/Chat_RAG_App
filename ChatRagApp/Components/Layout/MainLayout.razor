@using ChatRagApp.Components.Pages
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="page-shell @(IsDarkMode ? "theme-dark" : "theme-light")">
    <div class="page">
        <div class="sidebar">
            <NavMenu IsDarkMode="IsDarkMode" OnToggleTheme="ToggleThemeAsync" />
        </div>

        <main name="main-content">
            <Header IsDarkMode="IsDarkMode" />
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string DarkTheme = "dark";
    private const string LightTheme = "light";

    private bool IsDarkMode { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        IsDarkMode = await JS.InvokeAsync<bool>("themeManager.initialize");
        StateHasChanged();

        if (Navigation.Uri.Contains("/chat"))
        {
            JS.InvokeVoidAsync("eval", "document.querySelector('main[name=\\'main-content\\']').classList.add('main-content-disable-scrollbar')");
        }
        else
        {
            JS.InvokeVoidAsync("eval", "document.querySelector('main[name=\\'main-content\\']').classList.remove('main-content-disable-scrollbar')");
        }
    }

    private async Task ToggleThemeAsync()
    {
        IsDarkMode = !IsDarkMode;
        await JS.InvokeVoidAsync("themeManager.applyTheme", IsDarkMode ? DarkTheme : LightTheme);
    }
}

