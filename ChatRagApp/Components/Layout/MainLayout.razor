@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="page-shell @(IsDarkMode ? "theme-dark" : "theme-light")">
    <div class="page">
        <div class="sidebar">
            <NavMenu IsDarkMode="IsDarkMode" OnToggleTheme="ToggleThemeAsync" />
        </div>

        <main>
            <div class="top-row px-4 d-flex justify-content-between align-items-center">
                <div class="top-row-branding">
                    <span class="top-row-title">Chat RAG App</span>
                    <span class="top-row-mode">@(IsDarkMode ? "Dark mode" : "Light mode")</span>
                </div>
                <AuthorizeView>
                    <Authorized>
                        <div class="top-row-actions">
                            <span class="top-row-user">@context.User.Identity?.Name</span>
                            <a href="/account/logout" class="btn btn-sm btn-outline-primary">Logout</a>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string DarkTheme = "dark";
    private const string LightTheme = "light";

    private bool IsDarkMode { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        IsDarkMode = await JS.InvokeAsync<bool>("themeManager.initialize");
        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        IsDarkMode = !IsDarkMode;
        await JS.InvokeVoidAsync("themeManager.applyTheme", IsDarkMode ? DarkTheme : LightTheme);
    }
}

