@page "/account/login"
@layout ChatRagApp.Components.Layout.MainLayout

<PageTitle>Login — Chat RAG App</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-body p-5 text-center">
                    <div class="fs-1 mb-3">🤖</div>
                    <h2 class="card-title mb-1">Chat RAG App</h2>
                    <p class="text-muted mb-4">Sign in to continue</p>

                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <div class="alert alert-danger" role="alert">
                            Authentication failed. Please try again.
                        </div>
                    }

                    <a href="/account/external-login?provider=Google&returnUrl=/"
                       class="btn btn-lg btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.4c-.5 2.8-2.1 5.1-4.5 6.7v5.5h7.3c4.3-3.9 6.9-9.7 6.9-16.2z" />
                            <path fill="#34A853" d="M24 47c6.5 0 11.9-2.1 15.9-5.8l-7.3-5.5c-2.2 1.5-5 2.3-8.6 2.3-6.6 0-12.2-4.4-14.2-10.4H2.4v5.7C6.4 41.7 14.6 47 24 47z" />
                            <path fill="#FBBC05" d="M9.8 27.6c-.5-1.5-.8-3.1-.8-4.6s.3-3.1.8-4.6v-5.7H2.4A23.9 23.9 0 0 0 0 24c0 3.9.9 7.5 2.4 10.7l7.4-7.1z" />
                            <path fill="#EA4335" d="M24 9.5c3.7 0 7 1.3 9.6 3.8l7.2-7.2C36.9 2.1 31.5 0 24 0 14.6 0 6.4 5.3 2.4 13.3l7.4 5.7C11.8 13.9 17.4 9.5 24 9.5z" />
                        </svg>
                        Sign in with Google
                    </a>

                    <p class="text-muted mt-4 small">
                        Access is restricted to authorized Google accounts.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Error { get; set; }
}
