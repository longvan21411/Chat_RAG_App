@page "/chat"
@rendermode InteractiveServer
@attribute [Authorize]
@inject AgentFactory AgentFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Chat � Chat RAG App</PageTitle>

<div class="container-fluid py-3" style="max-width:960px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Chat @SelectedAgent?.Name</h1>
        <div class="d-flex gap-2 align-items-center">
            <label class="form-label mb-0 text-muted small">Agent:</label>
            <select class="form-select form-select-sm" style="width:200px"
                    @onchange="OnAgentChanged" disabled="@IsLoading">
                @foreach (var agent in Agents)
                {
                    <option value="@agent.Id" selected="@(agent.Id == SelectedAgentId)">
                        @agent.Name
                    </option>
                }
            </select>
        </div>
    </div>

    <!-- Chat window -->
    <div class="card border-0 shadow-sm mb-3" style="height:480px">
        <div class="card-body d-flex flex-column p-0">
            <div class="flex-grow-1 overflow-auto p-3" @ref="_chatContainer" id="chat-container">
                @if (!Messages.Any())
                {
                    <div class="text-center text-muted py-5">                        
                        <p>Start a conversation with <strong>@SelectedAgent?.Name</strong></p>
                    </div>
                }
                @foreach (var msg in Messages)
                {
                    <div class="d-flex mb-3 @(msg.Role == "user" ? "justify-content-end" : "justify-content-start")">
                        <div class="@(msg.Role == "user" ? "bg-primary text-white" : "bg-light") rounded-3 px-3 py-2"
                             style="max-width:75%; white-space:pre-wrap; word-break:break-word">
                            @if (msg.Role == "assistant")
                            {
                                <div class="fw-semibold text-muted small mb-1">@SelectedAgent?.Name</div>
                            }
                            @msg.Content
                            @if (msg.Role == "assistant" && msg.TokenUsage.Total > 0)
                            {
                                <div class="text-muted small mt-1">
                                    ?? in:@msg.TokenUsage.InputTokens out:@msg.TokenUsage.OutputTokens
                                </div>
                            }
                        </div>
                    </div>
                }
                @if (IsLoading)
                {
                    <div class="d-flex justify-content-start mb-3">
                        <div class="bg-light rounded-3 px-3 py-2">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span class="text-muted">@SelectedAgent?.Name is thinking...</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Suggested questions -->
    @if (SuggestedQuestions.Any())
    {
        <div class="mb-3 d-flex flex-wrap gap-2">
            @foreach (var q in SuggestedQuestions)
            {
                <button class="btn btn-sm btn-outline-secondary"
                        @onclick="() => UseQuestion(q)" disabled="@IsLoading">
                    @q
                </button>
            }
        </div>
    }

    <!-- Input -->
    <div class="input-group">
        <textarea class="form-control" rows="2" placeholder="Type your message�"
                  @bind="UserInput" @bind:event="oninput"
                  @onkeydown="HandleKeyDown" disabled="@IsLoading"
                  style="resize:none"></textarea>
        <button class="btn btn-primary px-4" @onclick="SendMessage"
                disabled="@(IsLoading || string.IsNullOrWhiteSpace(UserInput))">
            Send
        </button>
    </div>

    <!-- Token stats -->
    @if (SessionTokens.Total > 0)
    {
        <p class="text-muted small mt-2 text-end">
            Session tokens � input: @SessionTokens.InputTokens � output: @SessionTokens.OutputTokens � cached: @SessionTokens.CachedTokens
        </p>
    }
</div>

@code {
    private List<IAgent> Agents { get; set; } = [];
    private string SelectedAgentId { get; set; } = string.Empty;
    private IAgent? SelectedAgent => Agents.FirstOrDefault(a => a.Id == SelectedAgentId);
    private List<ChatMessage> Messages { get; set; } = [];
    private List<string> SuggestedQuestions { get; set; } = [];
    private string UserInput { get; set; } = string.Empty;
    private bool IsLoading { get; set; }
    private string UserId { get; set; } = string.Empty;
    private string SessionId { get; set; } = Guid.NewGuid().ToString();
    private TokenUsage SessionTokens { get; set; } = TokenUsage.Empty;
    private ElementReference _chatContainer;

    protected override async Task OnInitializedAsync()
    {
        Agents = AgentFactory.GetAllAgents().ToList();
        if (Agents.Count > 0)
            SelectedAgentId = Agents[0].Id;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        UserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                 ?? authState.User.Identity?.Name
                 ?? "anonymous";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("scrollToBottom", "chat-container");
    }

    private async Task SendMessage()
    {
        var text = UserInput.Trim();
        if (string.IsNullOrEmpty(text) || IsLoading) return;

        Messages.Add(new ChatMessage { Role = "user", Content = text });
        UserInput = string.Empty;
        SuggestedQuestions.Clear();
        IsLoading = true;
        StateHasChanged();

        try
        {
            var agent = SelectedAgent;
            if (agent is null) return;

            var response = await agent.ChatAsync(text, SessionId, UserId);

            Messages.Add(new ChatMessage
            {
                Role = "assistant",
                Content = response.Content,
                TokenUsage = response.TokenUsage,
                AgentId = agent.Id
            });

            SuggestedQuestions = response.SuggestedQuestions;
            SessionTokens = new TokenUsage(
                SessionTokens.InputTokens + response.TokenUsage.InputTokens,
                SessionTokens.OutputTokens + response.TokenUsage.OutputTokens,
                SessionTokens.CachedTokens + response.TokenUsage.CachedTokens);
        }
        catch (Exception ex)
        {
            Messages.Add(new ChatMessage { Role = "assistant", Content = $"Error: {ex.Message}" });
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendMessage();
    }

    private void OnAgentChanged(ChangeEventArgs e)
    {
        SelectedAgentId = e.Value?.ToString() ?? SelectedAgentId;
        Messages.Clear();
        SuggestedQuestions.Clear();
        SessionTokens = TokenUsage.Empty;
        SessionId = Guid.NewGuid().ToString();
    }

    private async Task UseQuestion(string q)
    {
        UserInput = q;
        await SendMessage();
    }

    public void Dispose() { }
}
