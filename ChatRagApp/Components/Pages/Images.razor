@page "/images"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IImageService ImageService

<PageTitle>Images — Chat RAG App</PageTitle>

<div class="images-page container py-4">
    <h3 class="mb-4">🖼️ Image Management</h3>

    @* <!-- Upload Section -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header images-section-header images-section-header-upload">
            <strong>Upload Images</strong>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Title</label>
                    <input class="form-control" @bind="UploadTitle" placeholder="Image title" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <input class="form-control" @bind="UploadCategory" placeholder="e.g. nature, products" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Description</label>
                    <input class="form-control" @bind="UploadDescription" placeholder="Describe the images" />
                </div>
                <div class="col-12">
                    <label class="form-label">Select Images (JPG, PNG, WEBP — max 10 MB each)</label>
                    <InputFile OnChange="OnFilesSelected" multiple accept=".jpg,.jpeg,.png,.webp,.gif"
                               class="form-control" disabled="@IsUploading" />
                </div>
            </div>

            @if (SelectedFiles.Any())
            {
                <div class="mt-3">
                    <p class="text-muted">@SelectedFiles.Count file(s) selected</p>
                    <button class="btn btn-primary" @onclick="UploadFiles" disabled="@IsUploading">
                        @if (IsUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Uploading…</span>
                        }
                        else
                        {
                            <span>Upload</span>
                        }
                    </button>
                </div>
            }

            @if (UploadResults.Any())
            {
                <div class="mt-3">
                    @foreach (var r in UploadResults)
                    {
                        <div class="alert @(r.Success ? "alert-success" : "alert-danger") py-2 mb-1">
                            @if (r.Success)
                            {
                                <span>✅ @r.FileName uploaded successfully.</span>
                            }
                            else
                            {
                                <span>❌ @r.FileName — @r.Error</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div> *@

    <!-- Search Section -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header images-section-header images-section-header-search">
            <strong>Search Images</strong>
        </div>
        <div class="card-body">
            <div class="input-group">
                <input class="form-control" @bind="SearchQuery" @bind:event="oninput"
                       placeholder="Describe what you're looking for…" @onkeydown="HandleSearchKey" />
                <button class="btn btn-secondary" @onclick="SearchImages" disabled="@IsSearching">
                    @if (IsSearching)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <span>Search</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Category sections: Cats, Dogs, Wilds -->
    <div class="mb-3">
        @if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            <div class="alert alert-info">Showing results for: <strong>@SearchQuery</strong></div>
        }
    </div>

    @foreach (var cat in Categories)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header images-section-header">
                <strong>@cat.DisplayName</strong>
            </div>
            <div class="card-body">
                @if (cat.IsLoading)
                {
                    <div class="text-muted">Loading…</div>
                }
                else if (!cat.Items.Any())
                {
                    <div class="text-muted">No images available in this category.</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var result in cat.Items)
                        {
                            <div class="col-md-4 col-lg-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <div style="cursor:pointer;" @onclick="() => ShowImageDetail(result.Id)">
                                            <div class="images-result-thumbnail rounded d-flex align-items-center justify-content-center mb-3"
                                                 style="height:140px; font-size:2rem; background:#f8f9fa; overflow:hidden;">
                                                @if (!string.IsNullOrWhiteSpace(result.FileName) && !string.IsNullOrWhiteSpace(result.Category))
                                                {
                                                    <img src="@($"/TrainedImg/{result.Category}/{result.FileName}")" alt="@result.Title" style="max-height: 110px; max-width: 100%; object-fit: contain;" />
                                                }
                                                else
                                                {
                                                    <span>🖼️</span>
                                                }
                                            </div>
                                            <h6 class="card-title text-truncate">@result.Title</h6>
                                            <div class="d-flex justify-content-between">
                                                <span class="badge bg-primary">@result.Category</span>
                                                <span class="badge bg-success">@result.Score.ToString("F2")</span>
                                            </div>
                                            <div class="mt-2 d-flex justify-content-between">
                                                <div>
                                                    <button class="btn btn-sm btn-outline-primary" @onclick:stopPropagation="true" @onclick="() => FindSimilarByText(result.Title)">Find similar</button>
                                                    <button class="btn btn-sm btn-outline-secondary ms-2" @onclick:stopPropagation="true" @onclick="() => FindSimilarByImage(result.Id)">Image similar</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* Image Detail Modal Popup (outside results grid) *@
    <ImageDetailModal ImageId="@SelectedImageId" Visible="@ShowDetailModal" VisibleChanged="@OnDetailModalChanged" />

</div>

@code {
    private class CategorySection
    {
        public string Key { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public List<ImageSearchResult> Items { get; set; } = new();
        public bool IsLoading { get; set; } = false;
    }

    private List<CategorySection> Categories { get; set; } = new();
    private string UploadTitle { get; set; } = string.Empty;
    private string UploadCategory { get; set; } = "general";
    private string UploadDescription { get; set; } = string.Empty;
    private List<IBrowserFile> SelectedFiles { get; set; } = [];
    private bool IsUploading { get; set; }
    private List<ImageUploadResult> UploadResults { get; set; } = [];

    private string SearchQuery { get; set; } = string.Empty;
    private bool IsSearching { get; set; }

    // Modal handlers
    private Guid? SelectedImageId;
    private bool ShowDetailModal;

    private void ShowImageDetail(Guid id)
    {
        SelectedImageId = id;
        ShowDetailModal = true;
    }

    private void OnDetailModalChanged(bool visible)
    {
        ShowDetailModal = visible;
        if (!visible)
        {
            SelectedImageId = null;
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        SelectedFiles = e.GetMultipleFiles(50).ToList();
        UploadResults.Clear();
    }

    private async Task UploadFiles()
    {
        if (!SelectedFiles.Any()) return;

        IsUploading = true;
        UploadResults.Clear();
        StateHasChanged();

        try
        {
            var formFiles = SelectedFiles.Select(f =>
                new BrowserFormFile(f)).Cast<Microsoft.AspNetCore.Http.IFormFile>().ToList();

            var metadata = new ImagePoint
            {
                Title = UploadTitle,
                Category = UploadCategory,
                Description = UploadDescription
            };

            UploadResults = await ImageService.UploadBulkAsync(formFiles, metadata);
            SelectedFiles.Clear();
        }
        catch (Exception ex)
        {
            UploadResults = new List<ImageUploadResult> { new ImageUploadResult { Success = false, FileName = "batch", Error = ex.Message } };
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Categories = new List<CategorySection>
        {
            new CategorySection { Key = "cats", DisplayName = "Cats" },
            new CategorySection { Key = "dogs", DisplayName = "Dogs" },
            new CategorySection { Key = "wild_animals", DisplayName = "Wilds" }
        };

        await LoadCategoriesAsync();
    }

    private async Task SearchImages()
    {
        IsSearching = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(SearchQuery))
            {
                await LoadCategoriesAsync();
                return;
            }

            var results = await ImageService.SearchByTextAsync(SearchQuery, 72);
            var resultsByCategory = results.GroupBy(r => r.Category).ToDictionary(g => g.Key, g => g.ToList());

            foreach (var c in Categories)
            {
                if (c.Items == null || !c.Items.Any())
                {
                    c.Items = await ImageService.GetImagesByCategoryAsync(c.Key, 24);
                }

                var matches = resultsByCategory.ContainsKey(c.Key) ? resultsByCategory[c.Key] : new List<ImageSearchResult>();
                var remaining = c.Items.Where(i => !matches.Any(m => m.Id == i.Id)).ToList();
                c.Items = matches.Concat(remaining).Take(24).ToList();
            }
        }
        catch
        {
            // ignore
        }
        finally
        {
            IsSearching = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchImages();
    }

    private async Task FindSimilarByText(string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        SearchQuery = query;
        await SearchImages();
    }

    private async Task FindSimilarByImage(Guid imageId)
    {
        IsSearching = true;
        StateHasChanged();

        try
        {
            var results = await ImageService.SearchByImageAsync(imageId, 72);
            var resultsByCategory = results.GroupBy(r => r.Category).ToDictionary(g => g.Key, g => g.ToList());

            foreach (var c in Categories)
            {
                if (c.Items == null || !c.Items.Any())
                {
                    c.Items = await ImageService.GetImagesByCategoryAsync(c.Key, 24);
                }

                var matches = resultsByCategory.ContainsKey(c.Key) ? resultsByCategory[c.Key] : new List<ImageSearchResult>();
                var remaining = c.Items.Where(i => !matches.Any(m => m.Id == i.Id)).ToList();
                c.Items = matches.Concat(remaining).Take(24).ToList();
            }
        }
        catch
        {
            // ignore
        }
        finally
        {
            IsSearching = false;
            StateHasChanged();
        }
    }

    private async Task LoadCategoriesAsync()
    {
        var tasks = Categories.Select(async c =>
        {
            c.IsLoading = true;
            StateHasChanged();
            c.Items = await ImageService.GetImagesByCategoryAsync(c.Key, 24);
            c.IsLoading = false;
        });

        await Task.WhenAll(tasks);
        StateHasChanged();
    }

    // ── Adapter: wrap IBrowserFile as IFormFile for the image service ──
    private sealed class BrowserFormFile : Microsoft.AspNetCore.Http.IFormFile
    {
        private readonly IBrowserFile _file;
        private const long MaxSize = 10 * 1024 * 1024;

        public BrowserFormFile(IBrowserFile file) => _file = file;

        public string ContentType => _file.ContentType;
        public string ContentDisposition => $"form-data; name=\"file\"; filename=\"{_file.Name}\"";
        public Microsoft.AspNetCore.Http.IHeaderDictionary Headers => new Microsoft.AspNetCore.Http.HeaderDictionary();
        public long Length => _file.Size;
        public string Name => "file";
        public string FileName => _file.Name;

        public void CopyTo(Stream target) => _file.OpenReadStream(MaxSize).CopyTo(target);
        public async Task CopyToAsync(Stream target, CancellationToken ct = default)
            => await _file.OpenReadStream(MaxSize).CopyToAsync(target, ct);
        public Stream OpenReadStream() => _file.OpenReadStream(MaxSize);
    }
}
